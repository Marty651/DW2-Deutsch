<?xml version="1.0"?>
<ArrayOfGameEvent xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<GameEvent>
		<Name>Wander Time (Teekan)</Name>
		<TriggerActions>
			<GameEventAction>
				<Type>StartColonyEvent</Type>
				<Id1>135</Id1> <!-- Colony Event Id, Current Value = Wander Time -->
				<Id2>-1</Id2> <!-- 0=Send Message -->
				<Id3>-1</Id3> <!-- If no valid ActionLocation then -1=Empire Capital, 0=Highest Developed Colony, 1=Random Colony -->
				<Value1>0</Value1> <!-- 1=Restart With New Duration Period -->
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
			<GameEventAction>
				<Type>GeneralStoryMessageToEmpire</Type>
				<MessageTitle>Wanderzeit</MessageTitle>
				<Description>Unsere kürzliche Ansiedlung einer neuen Kolonie in [LOCATION]{6}[/LOCATION] hat bei unserer Teekan-Bevölkerung eine neue Welle der Wanderlust und des Nomadentums entfacht.

Daher wird [LOCATION]{6}[/LOCATION] in den nächsten 5 Jahren ein sehr beliebtes Migrationsziel sein.</Description>
				<ImageFilepath>Environment/Events/Wander Time</ImageFilepath>
				<ActionLocationHint>GeneratedItemFromFirstAction</ActionLocationHint>
				<Id1>-1</Id1> <!-- Receiving Race Id (-1=Triggering Empire, 256=Player) -->
				<Id2>-1</Id2> <!-- Receiving Empire Id (-1=Unused) -->
				<Id3>-1</Id3> <!-- 1=Concatenate all descriptions when delayed -->
				<Value1>0</Value1> <!-- Display Options: 0=Normal, 1=Full Screen, 2=Normal Without Extra Info -->
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
