	<GameEvent>
		<Name>Search the Archives (Zenox)</Name>
		<SuppressTriggerDescriptions>true</SuppressTriggerDescriptions>
		<TriggerActions>
			<GameEventAction>
				<Type>SetGlobalVariableRandomRange</Type>
				<ActionLocationHint>GeneratedItemFromFirstAction</ActionLocationHint>
				<Value1>0</Value1> <!-- Minimum Value -->
				<Value2>100</Value2> <!-- Maximum Value -->
				<GeneratedItemName>SearchTheArchives_RandomValue</GeneratedItemName>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
			<GameEventAction>
				<Type>StartColonyEvent</Type>
				<MessageTitle>Suche im Archiv</MessageTitle>
				<Description>Unsere Suche in den Archiven hat verschollene wissenschaftliche Erkenntnisse zutage gefördert, die unsere Forschungsanstrengungen beschleunigen!\n\nFür die nächsten zwei Jahre wird unser Reich von einem [BONUS]+5% Alle Forschungen[/BONUS] Bonus profitieren.</Description>
				<ImageFilepath>Environment/Events/Zenox Search the Archives</ImageFilepath>
				<Id1>130</Id1> <!-- Colony Event Id, Current Value = Search the Archives - Research Boost -->
				<Id2>0</Id2> <!-- 0=Send Message -->
				<Id3>-1</Id3> <!-- If no valid ActionLocation then -1=Empire Capital, 0=Highest Developed Colony, 1=Random Colony -->
				<Value1>1</Value1> <!-- 1=Restart With New Duration Period -->
				<Conditions>
					<GameEventCondition>
						<Type>VariableComparison</Type>
						<VariableName>SearchTheArchives_RandomValue</VariableName>
						<ComparisonType>GreaterThanOrEqual</ComparisonType>
						<ComparisonValue>0</ComparisonValue>
					</GameEventCondition>
					<GameEventCondition>
						<Type>VariableComparison</Type>
						<VariableName>SearchTheArchives_RandomValue</VariableName>
						<ComparisonType>LessThan</ComparisonType>
						<ComparisonValue>25</ComparisonValue>
					</GameEventCondition>
				</Conditions>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
			<GameEventAction>
				<Type>StartColonyEvent</Type>
				<MessageTitle>Suche im Archiv</MessageTitle>
				<Description>Unsere Suche in den Archiven hat weitere Details über die alten Zenox zutage gefördert, die die Menschen in unserem Reich faszinieren!\n\n In den nächsten zwei Jahren wird unsere Kolonie von einem [HL]+10 Glück[/HL] Schub profitieren.</Description>
				<ImageFilepath>Environment/Events/Zenox Search the Archives</ImageFilepath>
				<Id1>131</Id1> <!-- Colony Event Id, Current Value = Search the Archives - Happiness Boost -->
				<Id2>0</Id2> <!-- 0=Send Message -->
				<Id3>-1</Id3> <!-- If no valid ActionLocation then -1=Empire Capital, 0=Highest Developed Colony, 1=Random Colony -->
				<Value1>1</Value1> <!-- 1=Restart With New Duration Period -->
				<Conditions>
					<GameEventCondition>
						<Type>VariableComparison</Type>
						<VariableName>SearchTheArchives_RandomValue</VariableName>
						<ComparisonType>GreaterThanOrEqual</ComparisonType>
						<ComparisonValue>25</ComparisonValue>
					</GameEventCondition>
					<GameEventCondition>
						<Type>VariableComparison</Type>
						<VariableName>SearchTheArchives_RandomValue</VariableName>
						<ComparisonType>LessThan</ComparisonType>
						<ComparisonValue>50</ComparisonValue>
					</GameEventCondition>
				</Conditions>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
			<GameEventAction>
				<Type>NavigationalCoordinatesRandomSelection</Type>
				<MessageTitle>Suche im Archiv</MessageTitle>
				<Description>Unsere Suche in den Archiven hat einen besonderen Ort in der Galaxie aufgedeckt.\n\nDie Details über diesen Ort sind sehr dünn. Wir konnten nur durch beiläufige Erwähnungen in den Archiven auf diesen Ort schließen. Wir wissen also nicht viel über diesen Ort, außer dass er eine gewisse Bedeutung hat. Wir sollten diesen Ort wahrscheinlich untersuchen.\n\nEine [HL]Navigationsmarkierung ping[/HL] wurde zu unserer Galaxiekarte hinzugefügt. Diesen Ort finden Sie auch in unserer Liste der besonderen Orte im Abschnitt Erkundung.</Description>
				<ImageFilepath>Environment/Events/Zenox Search the Archives</ImageFilepath>
				<Id2>1</Id2> <!-- Unknown -->
				<Conditions>
					<GameEventCondition>
						<Type>VariableComparison</Type>
						<VariableName>SearchTheArchives_RandomValue</VariableName>
						<ComparisonType>GreaterThanOrEqual</ComparisonType>
						<ComparisonValue>50</ComparisonValue>
					</GameEventCondition>
					<GameEventCondition>
						<Type>VariableComparison</Type>
						<VariableName>SearchTheArchives_RandomValue</VariableName>
						<ComparisonType>LessThan</ComparisonType>
						<ComparisonValue>101</ComparisonValue>
					</GameEventCondition>
				</Conditions>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
